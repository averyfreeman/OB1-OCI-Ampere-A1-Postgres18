# Runtime secrets belong in /etc/ob1/ob1.env, not in Git.
OB1_BRAIN_KEY=generate-a-long-random-value
# Optional: the workspace used when a request omits workspace_id.
OB1_DEFAULT_WORKSPACE_ID=default
# Optional JSON array of least-privilege harness grants. Keep secrets here or
# in /etc/ob1/ob1.env only; never commit real values.
# OB1_SCOPE_GRANTS_JSON=[{"id":"codex","secret":"replace-me","default_workspace_id":"default","allowed_workspaces":["default"],"allowed_projects":["*"],"allowed_visibility":["personal","channel","project","workspace"],"capabilities":["recall","writeback"],"default_scope_mode":"auto","allow_unconfirmed":false,"include_legacy_thoughts":false}]
OPENAI_API_KEY=
OPENROUTER_API_KEY=

OB1_HOST=0.0.0.0
OB1_PORT=8787
DATABASE_URL=postgresql://ob1_app@127.0.0.1:5432/ob1
OB1_UPLOAD_ROOT=/var/lib/ob1/uploads
OB1_MAX_FILE_BYTES=26214400
OB1_UPLOAD_QUOTA_BYTES=2147483648
OB1_CORS_ORIGINS=http://100.113.183.43:3000,http://192.168.0.30:3000

OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENROUTER_CHAT_MODEL=openai/gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-large
OB1_EMBEDDING_DIMENSIONS=3072
OB1_REASONING_EFFORT=max
OB1_CHUNK_CHARS=6000
OB1_CHUNK_OVERLAP_CHARS=600
OB1_MAX_PDF_PAGES=200
OB1_MAX_VISION_PAGES=50
